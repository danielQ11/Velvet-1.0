# ── Base de datos MongoDB Atlas (productos + imágenes) ──
# Crea un cluster gratis en https://cloud.mongodb.com → Connect → Drivers → copia el URI
MONGODB_URI=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=velvet

# ── Login con Google (next-auth) ──
# Crea credenciales en https://console.cloud.google.com → APIs y servicios → Credenciales → ID de cliente OAuth
# Orígenes autorizados: http://localhost:3000 y https://tu-app.vercel.app
# URIs de redirección: http://localhost:3000/api/auth/callback/google y https://tu-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secreto para firmar sesiones (32+ caracteres). En Vercel: cualquier string aleatorio largo.
NEXTAUTH_SECRET=cambia-esto-por-un-secreto-largo-de-mas-de-32-caracteres
# URL pública de la app (en Vercel se configura sola con la domain; en local déjala así)
NEXTAUTH_URL=http://localhost:3000

# Correos de Google autorizados como administradoras (separados por coma)
ADMIN_EMAILS=tu-correo@gmail.com

# ── Legado local (solo si NO hay MONGODB_URI: usa SQLite data/velvet.db) ──
# ADMIN_EMAIL=admin@velvet.com
# ADMIN_PASSWORD_HASH=
# AUTH_SECRET=
